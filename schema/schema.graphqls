# GoNetLogo API. One Session is an isolated interpreter and world.
# The shared schema lives here so the Go server and the web client
# can both treat it as the contract.

type Query {
  models: [String!]!
  session(id: ID!): Session
  """Dimensions, patch size, and wrapping for one session."""
  worldSettings(sessionId: ID!): WorldSettings!
}

type Mutation {
  createSession(model: String!): Session!
  """
  Load one embedded demo by file name, for example fire.nlogo.
  A path separator or .. is rejected. This does not read the filesystem.
  """
  loadModel(sessionId: ID!, model: String!): Session!
  """
  Replace the session with a .nlogo or .nlogox model sent as file contents.
  filename is the original file name. The extension picks a parser when the
  text is ambiguous; a document that is clearly one format is parsed as that
  format. A compile error includes a line number and leaves the current model
  in place.
  """
  loadModelSource(sessionId: ID!, filename: String!, source: String!): Session!
  """
  Load a model file from the server models directory.
  That directory is MODELS_DIR, or ./models when the variable is unset.
  path is relative to it. Absolute paths and any .. segment are rejected.
  """
  loadModelFile(sessionId: ID!, path: String!): Session!
  setCode(sessionId: ID!, code: String!): CompileResult!
  runCommand(sessionId: ID!, text: String!): CommandResult!
  setup(sessionId: ID!): Session!
  """Start the forever button (go)."""
  go(sessionId: ID!): Session!
  stop(sessionId: ID!): Session!
  """Run the go procedure a single time."""
  step(sessionId: ID!): Session!
  pressButton(sessionId: ID!, index: Int!): Session!
  setSpeed(sessionId: ID!, speed: Float!): Session!
  """
  Cap how often a new world snapshot is published.
  fps is clamped to 1..120. The model keeps stepping; intermediate
  snapshots are skipped instead of queued.
  """
  setFrameRate(sessionId: ID!, fps: Int!): Session!
  setSlider(sessionId: ID!, index: Int!, value: Float!): Session!
  setSwitch(sessionId: ID!, index: Int!, on: Boolean!): Session!
  setChooser(sessionId: ID!, index: Int!, current: Int!): Session!
  setInput(sessionId: ID!, index: Int!, text: String!): Session!
  """
  Resize the world and set patch size and wrapping.
  Turtles and links die and patches are reset, as with resize-world.
  """
  setWorld(
    sessionId: ID!
    minPxcor: Int!
    maxPxcor: Int!
    minPycor: Int!
    maxPycor: Int!
    patchSize: Float!
    wrapX: Boolean!
    wrapY: Boolean!
  ): Session!
}

type Subscription {
  """World, widgets, and ticks. Emitted after each change and while go is running."""
  frames(sessionId: ID!): Frame!
}

type Session {
  id: ID!
  modelName: String!
  code: String!
  ticks: Float
  ticksStarted: Boolean!
  """Smoothed ticks per second over about the last second. Zero while stopped."""
  tps: Float!
  """Elapsed run time, paused while stopped. mm:ss.s, or h:mm:ss from one hour."""
  timer: String!
  """Publish cap in frames per second. 1..120, default 24."""
  frameRateCap: Int!
  """Model steps since setup that were never published because of the cap."""
  droppedFrames: Int!
  """Publishes a slow subscriber missed. Separate from droppedFrames."""
  droppedSlow: Int!
  """Frames actually published over about the last second."""
  publishedFps: Float!
  running: Boolean!
  speed: Float!
  notes: [String!]!
  log: [String!]!
  """True when the model has an output widget. Otherwise output-* uses the command center."""
  hasOutput: Boolean!
  """Completed output-area lines, capped at the last 2000."""
  output: [String!]!
  """Text from output-type / output-write that has not ended a line yet."""
  outputPartial: String!
  widgets: [Widget!]!
  world: World!
}

type CompileResult {
  ok: Boolean!
  error: String
  session: Session!
}

type CommandResult {
  ok: Boolean!
  output: String
  error: String
  session: Session!
}

type Frame {
  sessionId: ID!
  ticks: Float
  ticksStarted: Boolean!
  """Smoothed ticks per second over about the last second. Zero while stopped."""
  tps: Float!
  """Elapsed run time, paused while stopped. mm:ss.s, or h:mm:ss from one hour."""
  timer: String!
  """Publish cap in frames per second. 1..120, default 24."""
  frameRateCap: Int!
  """Model steps since setup that were never published because of the cap."""
  droppedFrames: Int!
  """Publishes a slow subscriber missed. Separate from droppedFrames."""
  droppedSlow: Int!
  """Frames actually published over about the last second."""
  publishedFps: Float!
  running: Boolean!
  speed: Float!
  log: [String!]!
  """True when the model has an output widget. Otherwise output-* uses the command center."""
  hasOutput: Boolean!
  """
  Completed lines this subscriber has not applied yet.
  When outputReset is true, replace the previous text with these lines.
  The server retains at most the last 2000 lines.
  """
  outputAppend: [String!]!
  """Text from output-type / output-write that has not ended a line yet."""
  outputPartial: String!
  """True when the client should discard previous output text before applying outputAppend."""
  outputReset: Boolean!
  """Increments when the output area is cleared or the model is replaced."""
  outputEpoch: Int!
  """Completed lines in this epoch, including lines dropped by the 2000-line cap."""
  outputSeq: Int!
  widgets: [Widget!]!
  world: World!
  """Plots in widget order. Points are not included; see plotAppend."""
  plots: [PlotView!]!
  """
  Samples added since this subscriber's previous frame.
  A pen with nothing new is omitted. reset replaces that pen's samples.
  """
  plotAppend: [PlotPenDelta!]!
}

"""Axes and pens for one plot. The point history is not in this object."""
type PlotView {
  index: Int!
  name: String!
  xLabel: String!
  yLabel: String!
  xMin: Float!
  xMax: Float!
  yMin: Float!
  yMax: Float!
  """True when a pen-down sample outside the range grows that range."""
  autoPlot: Boolean!
  legend: Boolean!
  """Compile or runtime error from the plot or a pen. Empty when healthy."""
  error: String!
  pens: [PlotPenView!]!
}

"""One pen, without its samples."""
type PlotPenView {
  name: String!
  r: Int!
  g: Int!
  b: Int!
  """line, bar, or point."""
  mode: String!
  interval: Float!
}

"""One sample. down is false when the pen was up, which breaks the line."""
type PlotPoint {
  x: Float!
  y: Float!
  down: Boolean!
}

"""Samples one pen gained since the subscriber's cursor."""
type PlotPenDelta {
  plotIndex: Int!
  penIndex: Int!
  """Changes when the pen is cleared."""
  epoch: Int!
  """Samples added in this epoch, including ones dropped from the retained window."""
  seq: Int!
  """True when the subscriber should discard this pen's previous samples."""
  reset: Boolean!
  points: [PlotPoint!]!
}

type Widget {
  index: Int!
  kind: String!
  display: String!
  variable: String
  forever: Boolean!
  disabled: Boolean!
  min: Float
  max: Float
  value: Float
  step: Float
  units: String
  on: Boolean
  reading: String
  choices: [String!]
  current: Int
  text: String
  """Interface position in pixels. Zero when the file did not specify it."""
  x: Int!
  y: Int!
  width: Int!
  height: Int!
  """Point size for an output widget. Zero for widgets that do not use it."""
  fontSize: Int!
}

type WorldSettings {
  """Publish cap in frames per second. 1..120, default 24."""
  frameRateCap: Int!
  minPxcor: Int!
  maxPxcor: Int!
  minPycor: Int!
  maxPycor: Int!
  patchSize: Float!
  wrapX: Boolean!
  wrapY: Boolean!
}

type World {
  minPxcor: Int!
  maxPxcor: Int!
  minPycor: Int!
  maxPycor: Int!
  width: Int!
  height: Int!
  patchSize: Float!
  wrapX: Boolean!
  wrapY: Boolean!
  """
  Label point size at patchSize. NetLogo's default is 10.
  The view scales it with the patch when the canvas is a different size.
  """
  labelFont: Int!
  """
  Turtle shapes from the model, in file order. Empty only when no library
  is loaded. A shape with rotatable false ignores heading.
  """
  shapes: [TurtleShape!]!
  """
  Base64 RGB bytes, one pixel per patch, row-major.
  Row 0 is maxPycor and column 0 is minPxcor.
  The decoded length is width * height * 3.
  Patch colors only. Pen trails and stamps are in drawing.
  """
  patchColors: String!
  """
  Drawing layer, oldest first: pen strokes and turtle stamps.
  Empty after clear-drawing and clear-all, and when nothing has been drawn.
  """
  drawing: [DrawingMark!]!
  """
  Turtle, patch, and link labels with a non-empty rendered string.
  Hidden agents are omitted. The text is formatted from the stored value.
  """
  labels: [AgentLabel!]!
  turtles: [Turtle!]!
  links: [Link!]!
}

"""One pen stroke or stamp on the drawing layer."""
type DrawingMark {
  """True for a pen stroke. False for a stamp."""
  pen: Boolean!
  """True when a stamp erases drawing under the turtle's shape."""
  erase: Boolean!
  x: Float!
  y: Float!
  """End of a pen stroke. Equal to x and y for a stamp."""
  x2: Float!
  y2: Float!
  heading: Float!
  size: Float!
  """Empty for a pen stroke. Turtle shape name for a stamp."""
  shape: String!
  r: Int!
  g: Int!
  b: Int!
}

"""
A non-empty label. A turtle sets who. A patch sets px and py.
A link sets lx and ly to the midpoint. The other fields are null.
"""
type AgentLabel {
  """Turtle who. Null for a patch or link label."""
  who: Int
  """Patch column. Null for a turtle or link label."""
  px: Int
  """Patch row. Null for a turtle or link label."""
  py: Int
  """Link midpoint x. Null for a turtle or patch label."""
  lx: Float
  """Link midpoint y. Null for a turtle or patch label."""
  ly: Float
  text: String!
  r: Int!
  g: Int!
  b: Int!
}

"""A turtle shape in NetLogo's 300 by 300 editor. Y grows downward."""
type TurtleShape {
  name: String!
  """When false, the shape is drawn upright and heading is ignored."""
  rotatable: Boolean!
  elements: [ShapeElement!]!
}

"""One polygon, rectangle, circle, or line in a turtle shape."""
type ShapeElement {
  """polygon, rectangle, circle, or line."""
  kind: String!
  filled: Boolean!
  """When true, paint this element with the turtle's color."""
  marked: Boolean!
  r: Int!
  g: Int!
  b: Int!
  """Polygon vertices or a line's endpoints, as x, y pairs."""
  points: [Float!]!
  """Circle or rectangle origin in editor coordinates."""
  x: Float!
  y: Float!
  """Rectangle width, or circle diameter."""
  w: Float!
  """Rectangle height, or circle diameter."""
  h: Float!
}

type Turtle {
  who: Int!
  x: Float!
  y: Float!
  heading: Float!
  size: Float!
  shape: String!
  hidden: Boolean!
  r: Int!
  g: Int!
  b: Int!
}

type Link {
  x1: Float!
  y1: Float!
  x2: Float!
  y2: Float!
  hidden: Boolean!
  r: Int!
  g: Int!
  b: Int!
}
